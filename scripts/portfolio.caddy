# Server config for velmren.com, installed as /etc/caddy/sites/portfolio.caddy
# (the main Caddyfile imports /etc/caddy/sites/*.caddy). Check with:
#   sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile && sudo systemctl reload caddy
velmren.com {
	# Security headers (audit 02.10.2026, step 6); snippets in 00-velmren-snippets.caddy.
	import velmren_security_headers
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
	# Health status for the uptime check (audit 02.10.2026, step 4).
	import velmren_health
	root * /srv/velmren/sites/portfolio/current
	# Text, scripts, data and wasm are compressed on the fly; large files ship
	# with .br/.gz siblings from scripts/package-release.mjs and are served as they are.
	encode {
		zstd
		gzip
		minimum_length 1024
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/wasm*
			header Content-Type application/xml*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
			header Content-Type image/x-icon*
		}
	}
	header X-Content-Type-Options nosniff
	# Hashed build output never changes under the same name: Next.js chunks and Vite assets.
	@immutable path_regexp ^/(_next/static/|(projects/[^/]+|forma/live)/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2?|png|jpe?g|webp|svg|avif)$)
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# Pages and their data payloads are revalidated so a new release shows up at once.
	# no-transform keeps Cloudflare from rewriting the pages: its Email Obfuscation would replace the published
	# address with a decode script and a /cdn-cgi/ link that crawlers see as a 404. Caddy compresses them itself.
	@pages path / */ *.html *.txt
	header @pages Cache-Control "no-cache, no-transform"
	# Other static files keep their names between releases: cache for an hour only.
	@static path *.js *.css *.json *.wasm *.pck *.webp *.avif *.png *.jpg *.jpeg *.svg *.ico *.woff *.woff2 *.mp4 *.webm *.zip *.jar
	header @static ?Cache-Control "public, max-age=3600"
	# Live demos, service pages and data payloads stay out of search results: the work pages are what should be
	# found, and they link to the demos. Links on a demo are still followed.
	@demos path /projects/* /forma/live/* /assets/godot/web/* /concepts/* /en/concepts/*
	header @demos X-Robots-Tag "noindex, follow"
	@asset_pages path_regexp ^/assets/.*\.html$
	header @asset_pages X-Robots-Tag "noindex, follow"
	@payloads {
		path *.txt
		not path /robots.txt
	}
	header @payloads X-Robots-Tag "noindex"
	@private path /.git/* /.env /AGENTS.md
	respond @private 404
	# Clicks on the contacts are counted without cookies: a page sends one empty request per click
	# (src/components/ContactClicks.tsx) and the server only writes it down, to a log of its own.
	# scripts/contact-clicks.mjs sums the log up.
	@clicks path /ping/*
	log_name @clicks contacts
	respond @clicks 204
	file_server {
		precompressed br gzip
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
	log {
		output file /var/log/caddy/velmren-access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
	# Kept for a year: the count is read by weeks and compared over months.
	log contacts {
		no_hostname
		output file /var/log/caddy/velmren-contacts.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 8760h
		}
	}
}
www.velmren.com {
	header Strict-Transport-Security "max-age=31536000"
	redir https://velmren.com{uri} permanent
}
